[Unit]
Description=Vagabond Edge Stack
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/vagabond
ExecStart=/usr/bin/docker compose -f docker-compose.pi.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f docker-compose.pi.yml down
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
