# agent/rpi-build/.env.builder.example
# Copy to .env.builder and fill in values. Never commit .env.builder.

# SSH public key to inject into the Pi for passwordless access
SSH_PUBKEY_PATH=~/.ssh/id_ed25519.pub

# Vagabond stack secrets (written into /opt/vagabond/.env on the Pi)
POSTGRES_PASSWORD=change-me-strong-passphrase
JWT_SECRET=change-me-to-a-long-random-secret
NEXTAUTH_SECRET=change-me-nextauth-secret

# Canonical user UUID — persists across flashes so trip data stays consistent
VAGABOND_DEV_USER_ID=
VAGABOND_DEV_USER_EMAIL=brian@vagabond.local
VAGABOND_DEV_USER_DISPLAY_NAME=Brian

# Optional: pre-configure upstream WiFi (Pi connects on first boot)
# Leave blank for hotspot-only mode or manual NetworkManager config.
VAGABOND_WIFI_SSID=
VAGABOND_WIFI_PSK=
