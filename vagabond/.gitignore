# ── Environment ───────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Rust ──────────────────────────────────────────────────────────────────────
target/
**/*.rs.bk
Cargo.lock          # kept for binaries; remove this line if you want to commit it

# ── Node / Next.js ────────────────────────────────────────────────────────────
node_modules/
.next/
out/
web/vagabond-web/.env*

# ── Docker ────────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Database ──────────────────────────────────────────────────────────────────
*.sql.bak

# ── PMTiles ───────────────────────────────────────────────────────────────────
# Tile archives are large; store in object storage, not git
*.pmtiles

# ── GPX / geo data ────────────────────────────────────────────────────────────
# Commit example files only; never commit personal trip data
*.gpx
!docs/examples/*.gpx

# ── OS / IDE ──────────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo
