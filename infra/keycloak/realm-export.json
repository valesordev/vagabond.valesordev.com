{
  "realm": "vagabond",
  "enabled": true,
  "displayName": "Vagabond",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "accessTokenLifespan": 300,
  "ssoSessionMaxLifespan": 36000,
  "clients": [
    {
      "clientId": "vagabond-web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost/api/auth/callback/keycloak",
        "http://127.0.0.1/api/auth/callback/keycloak",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "webOrigins": [
        "http://localhost",
        "http://127.0.0.1"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "roles": {
    "realm": [
      { "name": "vagabond-user",  "description": "Standard user" },
      { "name": "vagabond-admin", "description": "Admin user" }
    ]
  },
  "users": [
    {
      "username": "vagabond-dev",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Vagabond",
      "lastName": "Dev User",
      "credentials": [
        {
          "type": "password",
          "value": "vagabond-dev",
          "temporary": false
        }
      ],
      "realmRoles": ["vagabond-user"]
    }
  ]
}
