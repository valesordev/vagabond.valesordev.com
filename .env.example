# vagabond/.env.example
# Copy to .env and fill in values. Never commit .env.
#
# Required vars are marked with (REQUIRED).
# Optional vars show their defaults.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=vagabond
POSTGRES_USER=vagabond
POSTGRES_PASSWORD=changeme          # (REQUIRED) — change before any deployment

# ── Server ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret   # (REQUIRED)
RUST_LOG=info                                   # trace | debug | info | warn | error
VAGABOND_DEV_AUTH=true                          # core default; set false with --profile auth + Keycloak JWTs
VAGABOND_DEV_USER_ID=00000000-0000-0000-0000-000000000001
VAGABOND_DEV_USER_EMAIL=dev-user@vagabond.local
VAGABOND_DEV_USER_DISPLAY_NAME=Dev User

# ── Ports (override if defaults collide on your machine) ──────────────────────
GATEWAY_PORT=80
WEB_PORT=3000
SERVER_PORT=3001
MARTIN_PORT=3002
POSTGRES_PORT=5432

# ── Next.js (web) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost
NEXT_PUBLIC_MARTIN_URL=http://localhost/tiles
# Optional local PMTiles basemap URL (HTTP range-served archive). Empty shows an in-map warning.
NEXT_PUBLIC_PMTILES_URL=

# NextAuth (OIDC via Keycloak) — copy into web/vagabond-web/.env.local for `npm run dev`
NEXTAUTH_URL=http://localhost
NEXTAUTH_SECRET=change-me-in-production
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost/auth
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/auth
NEXT_PUBLIC_KEYCLOAK_REALM=vagabond
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=vagabond-web
# Confidential clients only; leave empty when using the public `vagabond-web` client from realm-export (PKCE).
KEYCLOAK_CLIENT_SECRET=

# Edge middleware: true skips /trips and /rig protection (core local). Set false with --profile auth.
NEXT_PUBLIC_VAGABOND_DEV_AUTH=true

# Trip planner AI assistant (Story 13) — server-side only; set in web/vagabond-web/.env.local for `npm run dev`
# ANTHROPIC_API_KEY=sk-ant-...

# ── Auth (--profile auth) ────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
# Dev realm user seeded by infra/keycloak/realm-export.json (local only).
KEYCLOAK_DEV_USERNAME=vagabond-dev
KEYCLOAK_DEV_PASSWORD=vagabond-dev
KEYCLOAK_ISSUER=http://localhost/auth/realms/vagabond
KEYCLOAK_PORT=8080
# Create `vagabond-web` in Keycloak (or use infra/keycloak/realm-export.json): standard flow, redirect
# http://localhost/api/auth/callback/keycloak, web origin http://localhost

# ── Storage (--profile storage) ──────────────────────────────────────────────
MINIO_ROOT_USER=vagabond
MINIO_ROOT_PASSWORD=changeme
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Observability ────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
GRAFANA_ROOT_URL=http://localhost:3003
GRAFANA_PORT=3003
PROMETHEUS_PORT=9090

# ── Local MCP / tooling auth ──────────────────────────────────────────────────
# Service account token for mcp-grafana, Claude Code, and Cursor MCP.
# Generated automatically by: make grafana-sa-token
# Requires the observability stack to be running first: make up-observability
GRAFANA_LOCAL_SA_TOKEN=
