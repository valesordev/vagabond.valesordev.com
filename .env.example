# vagabond/.env.example
# Copy to .env and fill in values. Never commit .env.
#
# Required vars are marked with (REQUIRED).
# Optional vars show their defaults.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=vagabond
POSTGRES_USER=vagabond
POSTGRES_PASSWORD=changeme          # (REQUIRED) — change before any deployment

# ── Server ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret   # (REQUIRED)
RUST_LOG=info                                   # trace | debug | info | warn | error

# ── Ports (override if defaults collide on your machine) ──────────────────────
WEB_PORT=3000
SERVER_PORT=3001
MARTIN_PORT=3002
POSTGRES_PORT=5432

# ── Next.js (web) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MARTIN_URL=http://localhost:3002

# ── Auth profile (--profile auth) ────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme    # (REQUIRED for auth profile)
KEYCLOAK_ISSUER=http://localhost:8080/realms/vagabond
KEYCLOAK_PORT=8080

# ── Storage profile (--profile storage) ──────────────────────────────────────
MINIO_ROOT_USER=vagabond
MINIO_ROOT_PASSWORD=changeme        # (REQUIRED for storage profile)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Observability profile (--profile observability) ──────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
GRAFANA_ROOT_URL=http://localhost:3003
GRAFANA_PORT=3003
PROMETHEUS_PORT=9090
